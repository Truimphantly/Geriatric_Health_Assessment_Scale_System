@echo off
title 老年评估系统-停止全部服务
echo 停止前端 (3000)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :3000 ^| findstr LISTENING') do taskkill /F /PID %%a >nul 2>nul
echo 停止后端 API (8000)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8000 ^| findstr LISTENING') do taskkill /F /PID %%a >nul 2>nul
echo 停止 Celery...
powershell -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*celery_app.worker*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }"
echo 停止 Redis...
"C:\Users\A\dev-services\redis8\Redis-8.10.2-Windows-x64-msys2\redis-cli.exe" shutdown nosave >nul 2>nul
echo 停止 PostgreSQL...
"C:\Users\A\dev-services\pgsql\bin\pg_ctl.exe" -D "C:\Users\A\dev-services\pgdata" stop >nul 2>nul
echo 全部服务已停止。
pause
