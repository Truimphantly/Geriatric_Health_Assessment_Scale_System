  "interpretation": [
    {"condition": "total_score >= 20", "result": "重度抑郁风险，需立即安排专人跟进"},
    {"condition": "total_score >= 15", "result": "中重度抑郁风险，建议尽快复评与干预"},
    {"condition": "total_score >= 10", "result": "中度抑郁风险，需要心理老师跟进"},
    {"condition": "total_score >= 5", "result": "轻度抑郁风险，建议关注与观察"},
    {"condition": "total_score <= 4", "result": "未见明显抑郁症状"}
